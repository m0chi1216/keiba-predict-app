APP_DOMAIN=keiba.example.com
ACME_EMAIL=you@example.com
# true: require login (default); false: allow access without login, keeping HTTPS.
AUTH_ENABLED=true
AUTH_USER=admin
# Paste the output of: docker run --rm -it caddy:2-alpine caddy hash-password
# Keep the hash in SINGLE quotes so Docker Compose preserves dollar signs.
AUTH_PASSWORD_HASH=''
